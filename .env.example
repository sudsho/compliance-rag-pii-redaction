# aws / bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# jwt
JWT_SECRET=change-me-32-bytes-min-for-production-use-only
JWT_ALGORITHM=HS256
JWT_ISSUER=compliance-rag
JWT_AUDIENCE=member-services

# vector store
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=policies

# audit log (postgres)
AUDIT_DB_URL=postgresql+psycopg2://audit:audit@localhost:5432/audit

# presidio
PSEUDONYM_SALT=change-me-hex-32-bytes
PSEUDONYM_SALT_ROTATION_DAYS=30

# otel
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=compliance-rag

# feature flags
USE_LOCAL_EMBEDDINGS=false
USE_LOCAL_LLM=false
