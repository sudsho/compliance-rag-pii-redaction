name: test

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["3.11", "3.12"]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: pip
      - name: install
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          python -m spacy download en_core_web_lg
      - name: lint
        run: |
          pip install ruff
          ruff check src tests scripts
      - name: unit tests
        env:
          JWT_SECRET: ci-secret-32-bytes-abcdefghijklmn
          PSEUDONYM_SALT: "00000000000000000000000000000000"
          AUDIT_DB_URL: sqlite+pysqlite:///:memory:
        run: pytest -q
      - name: build image
        run: docker build -t compliance-rag:ci .
